---
import Base from "../layouts/Base.astro";
import { getAllDocs, urlOf, QUICK_PATH } from "../lib/docs";

const docs = await getAllDocs();

/** 一句话简介，与 README 的「你将实现」列保持一致 */
const DESC: Record<number, string> = {
  0: "学习地图、环境搭建",
  1: "消息结构、流式输出、abort",
  2: "天气 + 计算器工具、结构化输出",
  3: "核心 while 循环、终止条件",
  4: "Zod 定义工具、错误自愈、安全边界",
  5: "token 预算、历史压缩、system prompt",
  6: "文件记忆、embedding、mini-RAG",
  7: "子 Agent、流水线、并行 fan-out",
  8: "plan-then-execute、人工确认、可恢复会话",
  9: "增量工具调用、过程渲染、SSE 服务",
  10: "eval 基建、结构化日志、成本统计",
  11: "写 MCP server、接入外部工具生态",
  12: "迷你 Coding Agent（毕业项目）",
};

const chapters = docs.filter((d) => !d.meta.appendix);
const appendix = docs.find((d) => d.meta.appendix);
---

<Base title="首页" sidebar={false}>
  <div class="hero">
    <span class="hero__eyebrow">零框架 · 手写内核 · 13 章</span>
    <h1 class="hero__title">TS Agent：从零到英雄</h1>
    <p class="hero__sub">
      用 TypeScript 从零手写 AI Agent。不依赖 LangChain、不依赖 AI SDK 的黑盒封装——从一次最朴素的
      HTTP 请求开始，逐章搭建出具备工具调用、上下文管理、记忆、多 Agent 协作、审批控制、评测与 MCP
      生态接入的完整 Agent，最终做出一个迷你版 Claude Code。
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={urlOf("00-introduction")}>从第 0 章开始 →</a>
      <a class="btn" href={urlOf("12-capstone-mini-coding-agent")}>直看毕业项目</a>
    </div>
  </div>

  <h2 class="section-title">为什么这样学</h2>
  <p>
    市面上的 Agent 框架把最核心的东西（Agent 循环、上下文管理、工具协议）藏在了抽象层后面。一旦遇到
    agent 死循环、上下文爆炸、工具调用失败这类真实问题，框架使用者往往束手无策。
  </p>
  <p>
    本教程反其道而行：<strong>每一层抽象都亲手写一遍</strong>。写完之后，你不仅会用框架，更能看懂所有框架的共同内核——因为它们的本质是同一个
    <code>while</code> 循环。
  </p>

  <h2 class="section-title">目录</h2>
  <div class="cards">
    {
      chapters.map((d) => (
        <a class="card" href={urlOf(d.slug)}>
          <span class="card__no">{String(d.meta.order).padStart(2, "0")}</span>
          <span>
            <span class="card__title">{d.meta.short}</span>
            <span class="card__desc">{DESC[d.meta.order] ?? ""}</span>
          </span>
        </a>
      ))
    }
    {
      appendix && (
        <a class="card" href={urlOf(appendix.slug)}>
          <span class="card__no">附</span>
          <span>
            <span class="card__title">
              速查手册
              <span class="card__tag">术语表 · 陷阱清单</span>
            </span>
            <span class="card__desc">术语一句话解释、常见坑清单、延伸阅读</span>
          </span>
        </a>
      )
    }
  </div>

  <h2 class="section-title">两条阅读路线</h2>
  <div class="routes">
    <div class="route">
      <h3>完整路线（推荐）</h3>
      <p>按顺序读完，约 2~3 周（每天 1~2 小时）。</p>
      <p class="route__path">第 0 → 12 章 + 附录</p>
    </div>
    <div class="route">
      <h3>快速路线</h3>
      <p>先做出能跑的东西，再回头补工程细节。</p>
      <p class="route__path">第 {QUICK_PATH.join(" → ")} 章 → 回头补 5~11</p>
    </div>
  </div>

  <h2 class="section-title">环境准备</h2>
  <p>只需要 Node.js 和一个 LLM API Key。教程代码刻意保持<strong>零框架依赖</strong>：用原生 <code>fetch</code> 直连 OpenAI 兼容接口。</p>
  <pre class="prose-code"><code># Node.js 20+（自带 fetch 与 --env-file）
node -v

# 配套代码：npm install 后填入 .env 即可逐章运行
cd code
cp .env.example .env   # 填入你的 LLM_API_KEY

# 跑通第一章
npx tsx src/demos/01-hello.ts</code></pre>
  <p>
    <code>.env</code> 换服务商只需改三行：<code>LLM_BASE_URL</code> / <code>LLM_API_KEY</code> /
    <code>LLM_MODEL</code>，智谱 GLM、DeepSeek、OpenAI、Moonshot 等任何兼容服务商都能用。
  </p>

  <footer class="page-foot">
    全部章节均有配套可运行代码，位于仓库的 <code>code/</code> 目录；类型检查：
    <code>cd code &amp;&amp; npm run typecheck</code>。
  </footer>
</Base>